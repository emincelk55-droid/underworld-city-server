DATABASE_URL=your_database_url_here
JWT_SECRET=super_secret_key_here
# Yolculuk hızı (harita birimi başına saniye). Varsayılan 120.
TRAVEL_SECONDS_PER_UNIT=120
# Sadece geliştirmede: /api/profile/add-money endpoint'ini açar
ENABLE_DEV_ENDPOINTS=false
# Bölge savaşı turu süresi (dakika). Varsayılan 60.
WAR_ROUND_MINUTES=60
# Üretimde: NODE_ENV=production (JWT_SECRET en az 32 karakter olmalı)
NODE_ENV=development
# Başka bir adresten (ör. flutter run) bağlanılacaksa izin verilen adresler, virgülle
CORS_ORIGIN=http://localhost:8080
# Sohbet filtresine eklenecek kelimeler, virgülle
CHAT_BLOCKLIST=
